# Copy this file to .env for local development. Never commit real secrets.

# Shared secret bearer token clients must present to call POST /mcp.
# Minimum length: 32 characters.
MCP_API_KEY=replace-with-a-random-32-plus-character-secret

# Port the HTTP server listens on. Railway injects PORT automatically in
# production; MCP_PORT is used as a local-development fallback.
MCP_PORT=3000

# Host to bind the HTTP server to. Defaults to 0.0.0.0 in production.
MCP_HOST=0.0.0.0
