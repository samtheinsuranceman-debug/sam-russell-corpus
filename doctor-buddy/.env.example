# Core runtime
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=
OAUTH_SERVER_URL=
OAUTH_PORTAL_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# Release posture. "production" (default) fails closed until every attestation
# below is true. "preview" lets the public wellness edition run for review with
# the blockers listed at /healthz and a banner on every page; paid and clinical
# stay off. Set VITE_RELEASE_POSTURE to the same value at build time.
RELEASE_POSTURE=production
VITE_RELEASE_POSTURE=production

# Passwordless email-link sign-in, for hosts without an OAuth portal. Needs a
# Resend API key and a verified sender. Set VITE_EMAIL_AUTH=true at build time
# so the browser shows the sign-in page. VITE_APP_ID must be non-empty (any
# stable label) because the session token carries it. The mail provider's
# legal name belongs in AUTH_PROCESSOR_NAME and HEALTH_DATA_PROCESSORS.
EMAIL_AUTH_ENABLED=false
VITE_EMAIL_AUTH=false
RESEND_API_KEY=
MAIL_FROM=
OWNER_EMAIL=

# Public internet release posture (default = consumer wellness)
PUBLIC_WELLNESS_MODE=true
VITE_PUBLIC_WELLNESS_MODE=true
ENABLE_CLINICAL_TOOLS=false
VITE_ENABLE_CLINICAL_TOOLS=false
PRIVACY_CONTACT_EMAIL=privacy@example.com
VITE_PRIVACY_CONTACT_EMAIL=privacy@example.com
SECURITY_CONTACT_EMAIL=security@example.com
LEGAL_BUSINESS_NAME=replace-with-real-legal-operator-name
VITE_LEGAL_BUSINESS_NAME=replace-with-real-legal-operator-name
LEGAL_BUSINESS_ADDRESS=replace-with-real-business-mailing-address
VITE_LEGAL_BUSINESS_ADDRESS=replace-with-real-business-mailing-address
# Semicolon-separated legal names of vendors that can process consumer health data (hosting/AI/etc.)
HEALTH_DATA_PROCESSORS=replace-with-real-processor-names
VITE_HEALTH_DATA_PROCESSORS=replace-with-real-processor-names

# Paid subscription. Stripe Checkout + webhook + Customer Portal are created server-side.
ENABLE_PAID_SUBSCRIPTIONS=false
VITE_ENABLE_PAID_SUBSCRIPTIONS=false
MEMBERSHIP_PRICE_CENTS=9900
VITE_MEMBERSHIP_PRICE_CENTS=9900
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_INSIGHT=
SUBSCRIPTION_ENTITLEMENT_ENFORCEMENT_CONFIRMED=false
# Confirm after reviewing sales-tax obligations / payment-provider tax configuration for target jurisdictions.
SALES_TAX_REVIEW_CONFIRMED=false

# Marketing analytics are OFF by default and blocked on sensitive routes.
VITE_ENABLE_MARKETING_ANALYTICS=false
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Covered-entity / business-associate deployment only. Do not enable casually.
HIPAA_DEPLOYMENT_MODE=consumer
HIPAA_BAA_CONFIRMED=false
PHI_STORAGE_ENCRYPTION_CONFIRMED=false

# AI transport used by the public support features. Production requires an explicit HTTPS endpoint,
# credential, and processor legal name; that name must also appear in HEALTH_DATA_PROCESSORS.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
AI_PROCESSOR_NAME=replace-with-real-ai-processor-legal-name
AUTH_PROCESSOR_NAME=replace-with-real-authentication-provider-legal-name
# Clinical/R&D-only optional providers; keep unset in the public edition unless separately reviewed.
OPENROUTER_API_KEY=
GROK_API_KEY=

# Required production operator attestations (set true only after actually verified)
PRIVACY_SECURITY_REVIEW_CONFIRMED=false
CONSUMER_DATA_ENCRYPTION_CONFIRMED=false
AI_PROCESSOR_PRIVACY_REVIEW_CONFIRMED=false
PROCESSOR_CONTRACTS_CONFIRMED=false
EXTERNAL_RESEARCH_QUERY_REVIEW_CONFIRMED=false
INCIDENT_RESPONSE_PLAN_CONFIRMED=false
DATA_RETENTION_POLICY_CONFIRMED=false
CONSUMER_HEALTH_DATA_DELETION_WORKFLOW_CONFIRMED=false
# Public-edition automatic telemetry retention. Saved user content remains until the user deletes it.
PUBLIC_USAGE_LOG_RETENTION_DAYS=90
PUBLIC_SAFETY_EVENT_RETENTION_DAYS=90
PUBLIC_BACKUP_MAX_RETENTION_DAYS=35
PUBLIC_PRIVACY_REQUEST_DETAIL_RETENTION_DAYS=90

# Clinical Edition identity and HIPAA deployment prerequisites.
# These are ONLY for an intentionally configured clinical/covered-entity deployment.
CLINICAL_COVERED_ENTITY_NAME=
VITE_CLINICAL_COVERED_ENTITY_NAME=
CLINICAL_NPP_URL=
VITE_CLINICAL_NPP_URL=
HIPAA_SECURITY_RISK_ANALYSIS_CONFIRMED=false
HIPAA_ACCESS_CONTROL_REVIEW_CONFIRMED=false
HIPAA_AUDIT_CONTROLS_CONFIRMED=false
HIPAA_WORKFORCE_TRAINING_CONFIRMED=false
HIPAA_MINIMUM_NECESSARY_REVIEW_CONFIRMED=false
CLINICAL_HUMAN_REVIEW_REQUIRED=true

# Medically-driven financial planning (Finance section). No configuration:
# the 56 calculators, six strategies and the fact finder run in the browser
# and store what the person enters in their own browser. In the public
# wellness edition the readiness panel reads the person's own 1-5 check-ins;
# the one server procedure that reads clinical records (finance.readiness)
# is blocked by releasePolicy.ts unless ENABLE_CLINICAL_TOOLS=true.
