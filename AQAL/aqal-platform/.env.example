# Server
NODE_ENV=development
PORT=3000

# App identity
VITE_APP_ID=aqal-dev

# Auth / sessions
JWT_SECRET=change-me
OAUTH_SERVER_URL=            # server-side OAuth base (empty = auth disabled locally)
OWNER_OPEN_ID=              # open id of the owner/admin account
VITE_OAUTH_PORTAL_URL=      # client OAuth portal base (empty = login falls back to /login)

# Database (MySQL)
DATABASE_URL=mysql://user:pass@localhost:3306/aqal

# ── Providers (platform seam) ────────────────────────────────
# Each capability picks the first configured provider and otherwise runs on a
# safe local mock, so the app boots and the core loop works with none of these.

# LLM + speech-to-text — OpenAI is the default (OpenAI-compatible drop-in).
# Empty = falls back to Forge, then to a deterministic mock.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com   # override for Azure/OpenRouter/etc.
OPENAI_MODEL=gpt-4o                       # chat/scoring model
OPENAI_TRANSCRIBE_MODEL=whisper-1         # speech-to-text model

# Legacy Manus gateway (fallback for existing deployments)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ── Multi-AI consensus panel (high-confidence / paid tier) ───
# The free tier scores with the single OPENAI model above. The paid tier fans out
# to every panel member below that has a key set, and takes the consensus (trimmed
# mean). A member with no key is simply skipped. Need 2+ for consensus to engage.
#   OpenAI/GPT uses OPENAI_API_KEY above. Add the others:
ANTHROPIC_API_KEY=            # Claude. Point ANTHROPIC_BASE_URL at an OpenAI-compatible
ANTHROPIC_BASE_URL=           #   gateway (e.g. OpenRouter) if calling Claude directly.
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GOOGLE_API_KEY=              # Gemini (OpenAI-compatible endpoint is the default base)
GOOGLE_MODEL=gemini-1.5-pro
XAI_API_KEY=                 # Grok (api.x.ai is OpenAI-compatible)
XAI_MODEL=grok-2-latest
GROQ_API_KEY=                # Llama via Groq (OpenAI-compatible, fast)
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=             # Mistral / Le Chat (api.mistral.ai, OpenAI-compatible, EU lab)
MISTRAL_MODEL=mistral-large-latest

# Perplexity — evidence verification (high-confidence tier only). Empty = mock
# (returns "unverified", never a false confirmation).
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

# Object storage — S3 or Cloudflare R2 (set S3_ENDPOINT for R2/MinIO).
# Empty = falls back to Forge, then to local filesystem (./.local-storage).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=                 # e.g. https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=          # optional CDN base for public reads

# Auth — Clerk swap seam (see server/platform/auth.ts). Empty = existing OAuth.
CLERK_SECRET_KEY=

# Stripe (payments) — empty disables payment routes, app still boots
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Beta access — a shared passcode that unlocks evidence-based verification free
# for the first BETA_MAX_REDEMPTIONS users (no card). Empty = beta gate disabled.
BETA_ACCESS_CODE=
BETA_MAX_REDEMPTIONS=50

# Free access — a UNIVERSAL passcode that lets anyone sign up free with just their
# email (no card, UNLIMITED). They take the assessment and get their low-confidence
# result emailed to that address. Defaults to "Welcome1" if unset.
FREE_ACCESS_CODE=Welcome1

# Email (optional) — Resend by default. Empty = mock (logs), app still runs.
RESEND_API_KEY=
EMAIL_FROM=AQAL Intelligence <onboarding@resend.dev>
